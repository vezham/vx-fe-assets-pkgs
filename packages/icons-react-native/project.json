{
  "name": "icons-react-native",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/icons-react-native/src",
  "projectType": "library",
  "tags": ["scope:icons"],
  "targets": {
    "build": {
      "cache": true,
      "inputs": ["default", "iconCatalog"],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "{projectRoot}"
      }
    }
  }
}
