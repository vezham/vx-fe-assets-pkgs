{
  "name": "@vezham/icons-react-native",
  "version": "27.0.3",
  "description": "React Native icon components for Vezham.",
  "keywords": [
    "android",
    "filled",
    "icon-library",
    "icons",
    "ios",
    "mobile",
    "outline",
    "react-native",
    "react-native-icons",
    "svg-icons",
    "tree-shakeable",
    "typescript"
  ],
  "homepage": "https://vezham.com",
  "bugs": {
    "url": "https://github.com/vezham/vx-fe-assets-pkgs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/vx-fe-assets-pkgs",
    "directory": "packages/icons-react-native"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
