      "import": "./dist/icons/*.js"
    },
    "./createIcon": {
      "types": "./dist/createIcon.d.ts",
      "import": "./dist/createIcon.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.cjs"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.64.0",
    "react-native-svg": ">=12.0.0"
  }
}
