{
  "name": "icons-flutter",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/icons-flutter/lib",
  "projectType": "library",
  "tags": ["scope:icons"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 tool/build_dart.py",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["default", "iconCatalog", "!{projectRoot}/lib/src/icons.dart"],
      "outputs": ["{projectRoot}/lib/src/icons.dart"]
    }
  }
}
