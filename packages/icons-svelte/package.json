{
  "name": "@vezham/icons-svelte",
  "version": "27.0.2",
  "description": "Svelte icon components for Vezham.",
  "keywords": [
    "filled",
    "icon-library",
    "icons",
    "outline",
    "svelte",
    "svelte-icons",
    "svelte3",
    "svelte4",
    "svelte5",
    "svg-icons",
    "tree-shakeable",
    "typescript"
  ],
  "homepage": "https://vezham.com",
  "bugs": {
    "url": "https://github.com/vezham/vx-fe-assets-pkgs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/vx-fe-assets-pkgs",
    "directory": "packages/icons-svelte"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/icons/*.svelte.d.ts",
      "svelte": "./dist/icons/*.svelte",
      "default": "./dist/icons/*.svelte"
    },
    "./Icon.svelte": {
      "types": "./dist/Icon.svelte.d.ts",
      "svelte": "./dist/Icon.svelte",
      "default": "./dist/Icon.svelte"
    }
  },
  "main": "./dist/index.js",
  "svelte": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.cjs"
  },
  "peerDependencies": {
    "svelte": ">=3.0.0"
  }
}
